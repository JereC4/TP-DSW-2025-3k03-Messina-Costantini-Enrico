# Puerto HTTP del backend
PORT=3000
# Misma URL que packages/database/.env (Prisma la lee de process.env en runtime)
DATABASE_URL="mysql://agro-dsw:CAMBIAR@localhost:3307/agro-dsw"
# Secreto para firmar JWT (usar uno largo y aleatorio en producción)
JWT_SECRET="cambiar-por-un-secreto-largo"
# Duración del token
JWT_EXPIRES_IN="8h"
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGIN="http://localhost:5173"
# Supabase Storage para la foto de perfil (ver docs/deploy.md § Supabase). Sin estas
# variables, subir/quitar foto de perfil responde 500; el resto de la app funciona igual.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# Service role key: NUNCA la anon/public key, y nunca exponerla al frontend
SUPABASE_SERVICE_ROLE_KEY="cambiar"
# Nombre del bucket de Storage (crearlo público en Supabase antes de usarlo)
SUPABASE_AVATARS_BUCKET="avatars"
